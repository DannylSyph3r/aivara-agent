# Google AI Studio — required
GOOGLE_API_KEY=

# Gemini model identifier — swap here to upgrade without code changes
GEMINI_MODEL=gemini-3-flash-preview

# Aivara MCP Server — the agent calls this as an MCP client
AIVARA_MCP_URL=https://aivara-tools.up.railway.app/mcp
AIVARA_MCP_API_KEY=

# This agent's own identity — required
AIVARA_AGENT_API_KEY=
AIVARA_AGENT_URL=http://localhost:8001

# Prompt Opinion FHIR context metadata key — must match what PO sends exactly
PO_FHIR_EXTENSION_URI=https://app.promptopinion.ai/schemas/a2a/v1/fhir-context

# Logging
LOG_LEVEL=INFO
LOG_HOOK_RAW_OBJECTS=false